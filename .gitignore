# OS
.DS_Store

# The shared intro video (config: intro_file) is user media, not code.
/intro.mp4

# Per-movie workspaces hold all generated media & runtime artifacts
# (input_images/, frames, clips, output, storyboard, logs, state). Each run uses
# projects/<name>/, so the whole tree is ignored.
# Anchored and WITHOUT a trailing slash on purpose: "projects/" matches a
# directory only, so when the dev tree's projects became a SYMLINK to the
# production checkout, git stopped ignoring it, `git add -A` committed the
# link, and the next deploy's checkout replaced production's real projects
# directory with it — destroying the data, silently, because git treats
# ignored paths as expendable. "/projects" matches the directory AND the
# symlink. Never let this path become trackable again.
/projects

# Admin panel (React/Vite) build artifacts
admin_ui/node_modules/
admin_ui/dist/

# Firebase service-account key (secret; FIREBASE_SERVICE_ACCOUNT in .env)
firebase-service-account.json
